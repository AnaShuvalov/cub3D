{
	ignore_lglfw_leaks
	Memcheck:Leak
	match-leak-kinds:all
	...
	obj:*/libglfw*
}
{
	ignore_opengl_leaks
	Memcheck:Leak
	match-leak-kinds:all
	...
	obj:*/libGL*
}
{
	ignore_dri_graphics_leaks
	Memcheck:Leak
	match-leak-kinds:all
	...
	obj:*/dri*
}
{
	ignore_glibc_dl_open
	Memcheck:Leak
	match-leak-kinds:all
	...
	fun:*dl*
}
{
	ignore_glibc_dl_read
	Memcheck:Addr8

	...
	fun:*dl*
}

